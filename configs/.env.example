###############################################################################
# Facial Attendance & Motion Tracking System — environment variables
#
# Copy to `.env` and edit before `docker compose up`:
#   cp configs/.env.example .env
#
# Every env var read by the app is documented here.
# DO NOT commit the real .env file. Production secrets should come from
# sealed-secrets / external-secrets / Vault.
###############################################################################

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://attendance:change-me-to-strong-password@db:5432/attendance
# K8s uses these separately (host + user/pass) for init-container probes
DB_HOST=db
DB_PORT=5432
DB_NAME=attendance
DB_USER=attendance
DB_PASSWORD=change-me-to-strong-password
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Postgres bootstrap (compose-only) ------------------------------------
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change-me-to-strong-password
POSTGRES_DB=attendance

# --- Redis (cooldown cache + pub-sub) -------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# --- Auth / security ------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret-not-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Comma-separated list of allowed CORS origins, or "*"
CORS_ORIGINS=*

# --- Observability --------------------------------------------------------
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                       # json | console
PROMETHEUS_PORT=8000
PROMETHEUS_PATH=/metrics
SENTRY_DSN=                           # https://<key>@<host>/<project>
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- CV pipeline ----------------------------------------------------------
GPU_ENABLED=false                    # true on GPU images / nodes
# Detector backend:
#   insightface  → InsightFace SCRFD detector from the selected model pack
#   yolo26       → Ultralytics YOLO26-face detector
DETECTOR_BACKEND=yolo26
# YOLO26-s benchmarked detector weights; ignored when DETECTOR_BACKEND=insightface.
DETECTOR_MODEL=yolo26s-face.pt
# Device override: "cpu", "cuda", "cuda:0". Empty = auto (uses GPU if GPU_ENABLED=true).
DETECTOR_DEVICE=
MODEL_NAME=buffalo_l                 # ArcFace recognizer pack; also contains SCRFD when selected
MODEL_DIR=/app/models                # model cache root in Docker deployments
DET_SIZE=640                         # SCRFD input dimension
SIMILARITY_THRESHOLD=0.30            # cosine sim above this => match (LFW: 0% FAR + 99.33% accuracy at 0.30)
COOLDOWN_SECONDS=30                  # min seconds between two logs of same face
MIN_FACE_SIZE=60                     # reject tiny faces (false positives)
MAX_FACES_PER_FRAME=50
TRACKER_TYPE=bytetrack               # bytetrack | sort
LIVENESS_ENABLED=true
LIVENESS_MIN_SCORE=0.5
DEFAULT_STRATEGY=both                # both | detection_only | tracking_only
CPU_CORES=0                          # 0 = detect with os.cpu_count()
ARCFACE_THREADING=auto               # auto | true | false
MAX_ARCFACE_THREADS=4

# --- Streams / WebSocket --------------------------------------------------
MAX_CAMERAS=32
MAX_STREAM_FPS=30
WS_MAX_QUEUE=128
WS_HEARTBEAT_INTERVAL=5
STREAM_FRAME_TIMEOUT=30

# --- API server (uvicorn) -------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
WORKERS=2                            # set to 4 for prod, 1 for dev (--reload)
MAX_UPLOAD_MB=32
RELOAD=false                         # true only for dev override

# --- Filesystem paths (container) -----------------------------------------
APP_HOME=/app
MODELS_DIR=/app/models
DATA_DIR=/app/data
LOG_DIR=/app/logs
TMP_DIR=/app/tmp

# --- Docker / Compose build hints (not read by the app itself) ------------
COMPOSE_PROJECT_NAME=facial-attendance
DOCKER_DEFAULT_PLATFORM=linux/amd64

# --- Grafana (compose-only) ----------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Runtime --------------------------------------------------------------
PYTHONUNBUFFERED=1
PYTHONPATH=/app
PYTHONDONTWRITEBYTECODE=1
