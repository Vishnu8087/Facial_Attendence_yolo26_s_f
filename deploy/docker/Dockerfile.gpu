# syntax=docker/dockerfile:1.6
###############################################################################
# Facial Attendance & Motion Tracking System — GPU image (CUDA 12.1)
# Single-stage build; build tools remain installed in the final image.
###############################################################################
ARG CUDA_VERSION=12.1.0
ARG UBUNTU_VERSION=22.04
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION}

LABEL org.opencontainers.image.title="facial-attendance-api-gpu" \
      org.opencontainers.image.description="FastAPI + InsightFace + ByteTrack — GPU image" \
      org.opencontainers.image.source="https://github.com/your-org/facial-attendance-system" \
      org.opencontainers.image.licenses="MIT"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CUDA_VISIBLE_DEVICES=0 \
    TF_CPP_MIN_LOG_LEVEL=3 \
    PYTHONPATH=/app

# Keep build dependencies in this single-stage image so native packages can
# build during installation without a separate builder image.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3.11-dev python3-pip \
        build-essential cmake git \
        libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 libgomp1 \
        libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
        ffmpeg libavcodec-dev libavformat-dev libswscale-dev \
        libpq-dev curl tini ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3.11 -m venv /opt/venv \
    && groupadd --system --gid 1001 app \
    && useradd --system --uid 1001 --gid app --create-home --home-dir /home/app --shell /usr/sbin/nologin app

ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app

COPY requirements/base.txt requirements/gpu.txt /tmp/requirements/
RUN python -m pip install --upgrade pip wheel setuptools \
    && python -m pip install -r /tmp/requirements/gpu.txt \
    && rm -rf /tmp/requirements

COPY --chown=app:app app/ /app/app/
COPY --chown=app:app configs/config.yaml /app/configs/config.yaml
COPY --chown=app:app frontend/ /app/frontend/
COPY --chown=app:app alembic.ini /app/alembic.ini
COPY --chown=app:app deploy/docker/entrypoint.sh /app/entrypoint.sh

RUN mkdir -p /app/models /app/data /app/logs /app/tmp \
    && chown -R app:app /app

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/app/entrypoint.sh"]
CMD ["api"]
